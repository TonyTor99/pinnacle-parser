# --- Telegram ---
# Токен бота от @BotFather
TG_BOT_TOKEN=
# ID администраторов через запятую (кому доступны кнопки управления)
ADMIN_IDS=
# Чат, куда шлются сигналы стратегий (можно задать кнопкой в боте, тогда оставить пустым)
SIGNAL_CHAT_ID=
# Чат мониторинга: карточка каждого матча на перерыве (можно задать кнопкой в боте)
STATS_CHAT_ID=

# --- Pinnacle (гостевой arcadia API) ---
# Публичный x-api-key из JS сайта pinnacle.com (при 401 обновить из вкладки Network браузера)
PINNACLE_API_KEY=CmX2KcMrXuFmNg6YFbmTxE0y9CIrOi0R

# --- Прокси (опционально) ---
# Стат-сайты (SofaScore/FlashScore) блокируют датацентр-IP сервера — тогда задайте
# STATS_PROXY (лучше residential). Pinnacle блокирует некоторые домашние IP — для
# локального запуска можно задать PINNACLE_PROXY. Пусто = ходить напрямую.
# Формат: http://user:pass@host:port  или  socks5://host:port (нужен pip install pysocks)
STATS_PROXY=
PINNACLE_PROXY=

# --- Параметры сбора ---
# Интервал опроса live-списка статистики, сек
POLL_INTERVAL_LIVE=30
# Окно сопоставления по времени начала матча, минуты (±)
MATCH_WINDOW_MIN=20
# Минимальный КФ линии угловых для сигнала
MIN_ODDS=1.65
